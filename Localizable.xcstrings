    "RecipeBook is your ultimate kitchen companion – whether you’re a beginner or a seasoned chef. Save your favorite recipes, explore new dishes, and create your own personalized cookbook, all in one place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RecipeBook ist Ihr ultimativer Küchenbegleiter – egal, ob Sie Anfänger oder erfahrener Koch sind. Speichern Sie Ihre Lieblingsrezepte, entdecken Sie neue Gerichte und erstellen Sie Ihr eigenes personalisiertes Kochbuch, alles an einem Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RecipeBook is your ultimate kitchen companion – whether you’re a beginner or a seasoned chef. Save your favorite recipes, explore new dishes, and create your own personalized cookbook, all in one place."
          }
        }
      }
    },
