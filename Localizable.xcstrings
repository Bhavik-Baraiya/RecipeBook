    "🧑‍🍳 Save and organize your own recipes\n❤️ Mark and share your favorite recipes\n🌐 Offline access anytime, anywhere\n📸 Add photos and notes to your recipes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "🧑‍🍳 Speichern und organisieren Sie Ihre eigenen Rezepte\n❤️ Markieren und teilen Sie Ihre Lieblingsrezepte\n🌐 Offline-Zugriff jederzeit und überall\n📸 Fügen Sie Fotos und Notizen zu Ihren Rezepten hinzu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
